# Rendered by fleet-init from fleet.env. Source on the mac venue.
# Samsung SM-G990B phone (1080x2340), Lenovo TB520FU tablet (1840x2944), both Android 16
# arm64-v8a. The phone stays first, so ANDROID_SERIAL and every unqualified run are
# unchanged; the tablet is the only Android TABLET form factor the venue has, so a
# layout-shaped Android check should claim it by serial rather than take the default.
export FLEET_ANDROID_SERIALS="RFCRC0FY4ZJ HA26QKR0"
# iPad Air 13-inch (M2) sim, physical iPad Air (4th gen), iPhone 16 Pro sim,
# iPad Air 13-inch (M3) sim (iOS 18.4), iPad Air 11-inch (M2) sim.
# The two extra iPads are here because iPad coverage was the scarce one: with four
# agents in flight, issue 112's run found "the two iPads were claimed by other runs"
# and fell back to the iPhone, which is the wrong form factor for a layout check.
# Order matters: the first is what a run takes when it picks no UDID of its own.
export FLEET_IOS_UDIDS="A42682BF-67BA-48CC-875F-B47E31F191FF 5E8DA01B-5B74-5EFB-B9B1-42E9C4707FAB 40696C9C-F8EE-483F-83FF-AFA89CCC5FE7 60F8C0FE-6BC3-4C1A-831E-9678B8B21F8E B8C06040-12CE-4E8D-B43A-53AE3A7B403C"
export ANDROID_SERIAL="${FLEET_ANDROID_SERIALS%% *}"
